numbers_list = [10, 20, 30, 40, 50]
numbers_tuple = (60, 70, 80, 90, 100)
numbers_set = {20, 40, 60, 80, 100}

print("List:", numbers_list)
print("Tuple:", numbers_tuple)
print("Set:", numbers_set)

numbers_list.append(60)
print("Updated List:", numbers_list)

print("Tuple Element:", numbers_tuple[2])

numbers_set.add(120)
print("Updated Set:", numbers_set)

print("Union:", numbers_set.union({140, 160}))
print("Intersection:", numbers_set.intersection(numbers_list))
print("Difference:", numbers_set.difference(numbers_list))
