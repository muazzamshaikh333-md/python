import json
import os
import base64
import hashlib
from cryptography.fernet import Fernet

FILE = "passwords.dat"
SALT_FILE = "salt.dat"


# ---------- KEY GENERATION ----------
def generate_key(master_password, salt):
    key = hashlib.pbkdf2_hmac(
        "sha256",
        master_password.encode(),
        salt,
        100000
    )
    return base64.urlsafe_b64encode(key)


# ---------- INITIAL SETUP ----------
def setup():
    print("\n=== PASSWORD MANAGER SETUP ===")

    master = input("Create Master Password: ")

    salt = os.urandom(16)

    with open(SALT_FILE, "wb") as f:
        f.write(salt)

    key = generate_key(master, salt)
    fernet = Fernet(key)

    data = {}

    encrypted = fernet.encrypt(json.dumps(data).encode())

    with open(FILE, "wb") as f:
        f.write(encrypted)

    print("Master password created successfully!")


# ---------- LOAD DATA ----------
def load_data(fernet):
    try:
        with open(FILE, "rb") as f:
            encrypted = f.read()

        decrypted = fernet.decrypt(encrypted)
        return json.loads(decrypted.decode())

    except Exception:
        return None


# ---------- SAVE DATA ----------
def save_data(data, fernet):
    encrypted = fernet.encrypt(
        json.dumps(data, indent=4).encode()
    )

    with open(FILE, "wb") as f:
        f.write(encrypted)


# ---------- ADD PASSWORD ----------
def add_password(data, fernet):
    website = input("Website/App: ")
    username = input("Username/Email: ")
    password = input("Password: ")

    data[website] = {
        "username": username,
        "password": password
    }

    save_data(data, fernet)

    print("\nPassword saved successfully!")


# ---------- SEARCH PASSWORD ----------
def search_password(data):
    website = input("Enter website/app name: ")

    if website in data:
        print("\n--- PASSWORD DETAILS ---")
        print("Website :", website)
        print("Username:", data[website]["username"])
        print("Password:", data[website]["password"])
    else:
        print("No password found!")


# ---------- SHOW ALL ----------
def show_all(data):
    if not data:
        print("No passwords stored.")
        return

    print("\n=== STORED ACCOUNTS ===")

    for website, details in data.items():
        print("\nWebsite :", website)
        print("Username:", details["username"])
        print("Password:", details["password"])


# ---------- DELETE ----------
def delete_password(data, fernet):
    website = input("Website to delete: ")

    if website in data:
        del data[website]
        save_data(data, fernet)
        print("Password deleted successfully!")
    else:
        print("Website not found!")


# ---------- MAIN PROGRAM ----------
def main():

    if not os.path.exists(FILE) or not os.path.exists(SALT_FILE):
        setup()

    print("\n=== SECURE PASSWORD MANAGER ===")

    master = input("Enter Master Password: ")

    with open(SALT_FILE, "rb") as f:
        salt = f.read()

    key = generate_key(master, salt)
    fernet = Fernet(key)

    data = load_data(fernet)

    if data is None:
        print("\n❌ Wrong Master Password!")
        return

    while True:

        print("\n========== MENU ==========")
        print("1. Add Password")
        print("2. Search Password")
        print("3. Show All Passwords")
        print("4. Delete Password")
        print("5. Exit")
        print("==========================")

        choice = input("Enter choice: ")

        if choice == "1":
            add_password(data, fernet)

        elif choice == "2":
            search_password(data)

        elif choice == "3":
            show_all(data)

        elif choice == "4":
            delete_password(data, fernet)

        elif choice == "5":
            print("Exiting Password Manager...")
            break

        else:
            print("Invalid choice!")


main()
