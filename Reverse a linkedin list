
class Node:
    def __init__(self, data):
        self.data = data
        self.next = None

def reverse(head):
    prev = None
    current = head

    while current:
        next_node = current.next
        current.next = prev
        prev = current
        current = next_node

    return prev

head = Node(10)
head.next = Node(20)
head.next.next = Node(30)

head = reverse(head)

while head:
    print(head.data, end=" ")
    head = head.next
