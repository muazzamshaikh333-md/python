queue = []

while True:
    print("1. Enqueue")
    print("2. Dequeue")
    print("3. Display")
    print("4. Exit")

    ch = int(input("Enter choice: "))

    if ch == 1:
        value = int(input("Enter value: "))
        queue.append(value)

    elif ch == 2:
        if len(queue) == 0:
            print("Queue is empty")
        else:
            print("Removed element:", queue.pop(0))

    elif ch == 3:
        print("Queue:", queue)

    elif ch == 4:
        break
