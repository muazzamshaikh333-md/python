
class Node:
    def __init__(self, data):
        self.data = data
        self.next = None

head = Node(10)
head.next = Node(20)
head.next.next = Node(30)

key = 20
position = 1
temp = head

while temp:
    if temp.data == key:
        print("Element found at position:", position)
        break
    temp = temp.next
    position += 1
else:
    print("Element not found")
