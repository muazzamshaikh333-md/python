stack = []

while True:
    print("1. Push")
    print("2. Pop")
    print("3. Display")
    print("4. Exit")

    ch = int(input("Enter choice: "))

    if ch == 1:
        value = int(input("Enter value: "))
        stack.append(value)

    elif ch == 2:
        if len(stack) == 0:
            print("Stack is empty")
        else:
            print("Popped element:", stack.pop())

    elif ch == 3:
        print("Stack:", stack)

    elif ch == 4:
        break
